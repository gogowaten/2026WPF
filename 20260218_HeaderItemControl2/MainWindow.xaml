<Window x:Class="_20260218_HeaderItemControl2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260218_HeaderItemControl2"
        xmlns:cc="clr-namespace:_20260218_HeaderItemControl2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding RootNodes}">
        <ItemsControl.ItemTemplate>
          <HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <cc:CollapsiblePanel Header="{Binding Name}">
              <ItemsControl ItemsSource="{Binding Children}">
                <ItemsControl.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <cc:CollapsiblePanel Header="{Binding Name}">
                      <ItemsControl ItemsSource="{Binding Children}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="20,0,0,0"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </cc:CollapsiblePanel>
                  </HierarchicalDataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </cc:CollapsiblePanel>
          </HierarchicalDataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</Window>
