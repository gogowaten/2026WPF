<Window x:Class="_20260622.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260622"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer x:Name="MyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid UseLayoutRounding="True">
        <Image x:Name="MyImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True" Stretch="None">
          <Image.LayoutTransform>
            <ScaleTransform x:Name="MyScaleTransform"
                            ScaleX="{Binding MyScale}" ScaleY="{Binding MyScale}"/>
          </Image.LayoutTransform>
        </Image>
        <Image x:Name="GridOverlay" RenderOptions.BitmapScalingMode="NearestNeighbor"
               SnapsToDevicePixels="True" Stretch="None"/>
      </Grid>
    </ScrollViewer>

    <StackPanel Grid.Column="1">

    </StackPanel>
  </Grid>
</Window>
