<Window x:Class="_20260222_ResizePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260222_ResizePanel"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Grid x:Name="MyCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
 
      <local:ResizePanel x:Name="MyPanel" Background="ForestGreen">
        <Rectangle x:Name="MyRect1" Width="100" Height="100" Fill="Yellow" Opacity="0.5"
                   local:ResizePanel.X="10" local:ResizePanel.Y="20"/>
        <Rectangle x:Name="MyRect2" Width="100" Height="100" Fill="Yellow" Opacity="0.5"
                   local:ResizePanel.X="150" local:ResizePanel.Y="50"/>
      </local:ResizePanel>
    </Grid>

    <StackPanel Grid.Column="1">
      <Button Content="Resize" Click="Button_Click"/>
      <Button Content="MyRect1Right" Click="Button_Click_1"/>
      <Button Content="MyRect1Left" Click="Button_Click_2"/>
      <Button Content="MyRect2Right" Click="Button_Click_3"/>
      <Button Content="MyRect2Left" Click="Button_Click_4"/>
    </StackPanel>
  </Grid>
</Window>
