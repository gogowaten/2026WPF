<Window x:Class="_20260219.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260219"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <Grid>
    <StackPanel Margin="10">
      <CheckBox x:Name="AutoCheck" Content="Auto Resize" IsChecked="True" />

      <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
        <local:ResizablePanel x:Name="MyPanel" 
                                      IsAutoSize="{Binding IsChecked, ElementName=AutoCheck}"
                                      Background="LightGray">

          <Button Content="Drag Me" Canvas.Left="10" Canvas.Top="110" Width="100"
                  Click="Button_Click"/>
          <Rectangle Fill="Blue" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />

          <Thumb Width="10" Height="10" Canvas.Right="0" Canvas.Bottom="0" Cursor="SizeNWSE"
                 
                  DragDelta="Thumb_DragDelta">
            <Thumb.Style>
              <Style TargetType="Thumb">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=local:ResizablePanel}, Path=IsAutoSize}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Thumb.Style>
          </Thumb>
          <Thumb Width="20" Height="20" Canvas.Left="20" Canvas.Top="50"
                 DragDelta="Thumb_DragDelta2"/>
        </local:ResizablePanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
