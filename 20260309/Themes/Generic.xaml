<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260309">


  <Style x:Key="CanvasItemContainer">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
  </Style>


  <DataTemplate DataType="{x:Type local:RectangleData}">
    <local:TThumb>
      <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </local:TThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:EllipseData}">
    <local:TThumb MyIsSelected="{Binding IsSelected}">      
      <Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </local:TThumb>
    <!--<Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>-->
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:GroupData}">
    <ItemsControl ItemsSource="{Binding DataList}"
                    ItemContainerStyle="{StaticResource CanvasItemContainer}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

    </ItemsControl>
  </DataTemplate>


  <Style TargetType="{x:Type local:TThumb}">
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <Setter Property="MyIsSelected" Value="{Binding IsSelected}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TThumb}">
          <ContentPresenter Content="{TemplateBinding MyContent}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:AAA}">
    <Setter Property="ItemsSource" Value="{Binding DataList}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CanvasItemContainer}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AAA}">
          <ItemsPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

  </Style>

  
</ResourceDictionary>
