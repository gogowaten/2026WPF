<Window x:Class="_20260305.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260305"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Window.DataContext>
    <local:RectangleVM/>
  </Window.DataContext>
  
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>


    <Canvas x:Name="MyCanvas">
      <!--<local:RectangleView Content="{Binding MyRectangleVM}" Canvas.Left="0" Canvas.Top="0"/>-->
      <local:RectangleView Content="{Binding Data}" Canvas.Left="150" Canvas.Top="0"/>
    </Canvas>
    
    <Canvas>
      <Canvas.DataContext>
        <local:RectangleGroupVM/>
      </Canvas.DataContext>
      <local:RectangleGroupView x:Name="RectangleGroupView" ItemsSource="{Binding Datas.Datas}" Canvas.Left="10" Canvas.Top="10"/>
    </Canvas>
    
    <Canvas>
      <Canvas.DataContext>
        <local:GroupVM/>
      </Canvas.DataContext>
      <local:GroupView x:Name="GroupVM" ItemsSource="{Binding Data.Datas}" Canvas.Left="10" Canvas.Top="110"/>
    </Canvas>

    
    
    <StackPanel Grid.Column="1">

    </StackPanel>
  </Grid>
</Window>
