<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260305">



  <DataTemplate DataType="{x:Type local:RectangleData}">
    <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="#33ccdd00"/>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:RectangleGroupData}">
    <Border BorderBrush="Red" BorderThickness="1" Width="200" Height="200">
      <ItemsControl ItemsSource="{Binding Datas}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas IsItemsHost="True"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <local:RectangleView Content="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:GroupData}">
    <ItemsControl ItemsSource="{Binding Datas}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <local:RectangleView Content="{Binding Datas}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>





  <Style TargetType="{x:Type local:GroupView}">
    <Setter Property="Width" Value="{Binding Data.Width}"/>
    <Setter Property="Height" Value="{Binding Data.Height}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GroupView}">
          <Border BorderBrush="Gold" BorderThickness="1">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:RectangleView Content="{Binding}"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style>
          <Setter Property="Canvas.Left" Value="{Binding X}"/>
          <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>



  <Style TargetType="{x:Type local:RectangleGroupView}">
    <Setter Property="Width" Value="{Binding  Datas.Width}"/>
    <Setter Property="Height" Value="{Binding Datas.Height}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RectangleGroupView}">
          <Border BorderBrush="Orange" BorderThickness="1">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:RectangleView Content="{Binding}"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style>
          <Setter Property="Canvas.Left" Value="{Binding X}"/>
          <Setter Property="Canvas.Top" Value="{Binding Y}"/>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>




  <Style TargetType="{x:Type local:RectangleView}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RectangleView}">
          <Grid>
            <ContentPresenter/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

  </Style>





</ResourceDictionary>
