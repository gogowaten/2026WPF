<Window x:Class="_20260706_Test_PathMarkup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260706_Test_PathMarkup"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <Path Canvas.Left="200" Data="M 10,10 L 110, 10 L 60, 100 Z m 200,0 L 250, 100" Stroke="Olive"/>
      <Path Canvas.Left="200" Canvas.Top="120" Data="M 20,10 H 100 M 20,20 h 100" Stroke="Tomato"/>
      <Path Canvas.Left="200" Canvas.Top="100" Data="M 00,100 C 00,100 100,300 200,100" Stroke="DeepPink"/>
      <Path Canvas.Left="200" Canvas.Top="100" Data="M 0,0 Q 100,200 200,200" Stroke="DeepSkyBlue"/>
      <Path Canvas.Left="200" Data="M 0,100 S 100,00 200,200" Stroke="MediumAquamarine"/>
      <Path Stroke="Gray">
        <Path.Data>
          <PathGeometry Figures="M 10,100 C 10,300 300,-200 300,200"/>
        </Path.Data>
      </Path>
      <Path Canvas.Left="100" Canvas.Top="100" x:Name="MyPath" Stroke="Orange">
        <Path.Data>
          <PathGeometry>
            <PathGeometry.Figures>
              <PathFigure>
                <PathFigure.Segments>
                  <PolyLineSegment Points="0,0 20,100"/>
                  <PolyLineSegment Points="110,0 120,100"/>
                </PathFigure.Segments>
              </PathFigure>
              <PathFigure StartPoint="50,110">
                <PolyLineSegment Points="40,20 140,110"/>
              </PathFigure>
            </PathGeometry.Figures>
          </PathGeometry>
        </Path.Data>
      </Path>
    </Canvas>

    <StackPanel Grid.Column="1">
      <Button Content="GetBounds" Click="Button_Click"/>
    </StackPanel>
  </Grid>
</Window>
