<Window x:Class="_20260206_CommunityToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260206_CommunityToolkit"
        d:DataContext="{d:DesignInstance Type=local:TextBoxViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">

    </Canvas>

    <StackPanel Grid.Column="1">
      <TextBox x:Name="MyTextBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
               Margin="1" 
               Foreground="{Binding Foreground, Mode=TwoWay}"
               FontFamily="MigMix 1M" FontSize="30" FontWeight="Thin">
        <TextBox.Background>
          <LinearGradientBrush StartPoint="0.0,0.0" EndPoint="1.0,1.0">
            <GradientStop Color="Red" Offset="0.0"/>
            <GradientStop Color="Green" Offset="1.0"/>
          </LinearGradientBrush>
        </TextBox.Background>
      </TextBox>
      <Button x:Name="SaveButton" Content="save" Click="SaveButton_Click"/>
      <Button x:Name="LoadButton" Content="load" Click="LoadButton_Click"/>
      <TextBox x:Name="MyTextBox2" Text="bbb"/>
      <Button x:Name="ForegroundRed" Content="文字色" Click="ForegroundRed_Click"/>
      <Button Content="文字のリセット" Command="{Binding ResetTextCommand}"/>
    </StackPanel>
  </Grid>
</Window>

