<Window x:Class="_20260204.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260204"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
        <Button Content="画像を開く" Click="OpenButton_Click" Padding="10,5"/>
        <Button Content="画像をグレースケールに" Click="GrayScaleButton_Click" Padding="10,5"/>
        <Button Content="右に90度回転" Click="RotateButton_Click" Padding="10,5" Margin="5,0,0,0"/>
        <Button Content="もとに戻す" Click="ResetButton_Click" Padding="10,5"/>
        
      </StackPanel>
      <StackPanel DockPanel.Dock="Top" Margin="10">
        <Label Content="明るさ調節"/>
        <Slider x:Name="BrightnessSlider" 
            Minimum="-255" Maximum="255" Value="0" 
            ValueChanged="BrightnessSlider_ValueChanged"
            TickFrequency="1" IsSnapToTickEnabled="True"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Top" Margin="10">
        <Label Content="回転角度 (度)"/>
        <DockPanel>
          <Slider x:Name="RotationSlider" Minimum="0" Maximum="360" Value="0" 
                TickFrequency="1" IsSnapToTickEnabled="True" Width="400"/>
          <TextBlock Text="{Binding ElementName=RotationSlider, Path=Value}" VerticalAlignment="Center" Margin="10,0"/>
          <Button Content="回転実行" Click="RotateFreeButton_Click" Padding="10,5"/>
        </DockPanel>
      </StackPanel>
      <Border BorderBrush="Gray" BorderThickness="1" Margin="10" UseLayoutRounding="True">
        <Image x:Name="MainImage" Stretch="None"/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
