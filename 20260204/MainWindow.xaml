<Window x:Class="_20260204.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260204"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
        <Button Content="画像を開く" Click="OpenButton_Click" Padding="10,5"/>
        <Button Content="画像をグレースケールに" Click="GrayScaleButton_Click" Padding="10,5"/>
        <Button Content="もとに戻す" Click="ResetButton_Click" Padding="10,5"/>
        
      </StackPanel>
      <StackPanel DockPanel.Dock="Top" Margin="10">
        <Label Content="明るさ調節"/>
        <Slider x:Name="BrightnessSlider" 
            Minimum="-255" Maximum="255" Value="0" 
            ValueChanged="BrightnessSlider_ValueChanged"
            TickFrequency="1" IsSnapToTickEnabled="True"/>
      </StackPanel>
      <Border BorderBrush="Gray" BorderThickness="1" Margin="10">
        <Image x:Name="MainImage" Stretch="Uniform"/>
      </Border>
    </DockPanel>
  </Grid>
</Window>
