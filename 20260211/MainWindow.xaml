  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Background="#F0F0F0" Margin="5">
      <TextBlock Text="矢印サイズ:" VerticalAlignment="Center" Margin="10,0,5,0"/>
      <Slider Minimum="5" Maximum="100" Width="150" VerticalAlignment="Center" Value="{Binding CurrentArrowSize}"/>
      <TextBlock Text="{Binding CurrentArrowSize, StringFormat={}{0:F0}}" VerticalAlignment="Center" Margin="5,0"/>
      <Button Content="開始" Command="{Binding StartDrawingCommand}" Margin="5" Padding="10,5"/>
      <Button Content="終了" Command="{Binding StopDrawingCommand}" Margin="5" Padding="10,5"/>
      <Button Content="保存" Command="{Binding SavePointsCommand}" Margin="5" Padding="10,5"/>
      <TextBlock Text="{Binding IsDrawing, StringFormat='描画中: {0}'}" VerticalAlignment="Center" Margin="10,0"/>
      <StackPanel Orientation="Horizontal" Background="#EEE">
        <Separator Margin="10,5"/>
        <TextBlock Text="色:" VerticalAlignment="Center" Margin="5,0"/>

        <Button Width="20" Height="20" Background="Blue" Command="{Binding ChangeColorCommand}" CommandParameter="Blue" Margin="2"/>
        <Button Width="20" Height="20" Background="Red" Command="{Binding ChangeColorCommand}" CommandParameter="Red" Margin="2"/>
        <Button Width="20" Height="20" Background="Green" Command="{Binding ChangeColorCommand}" CommandParameter="Green" Margin="2"/>
        <Button Width="20" Height="20" Background="Orange" Command="{Binding ChangeColorCommand}" CommandParameter="Orange" Margin="2"/>
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="5" Background="White">
      <Canvas x:Name="MainCanvas" Background="Transparent">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="MouseLeftButtonDown">
            <i:InvokeCommandAction Command="{Binding AddPointCommand}" 
                                               PassEventArgsToCommand="True" />
          </i:EventTrigger>
        </i:Interaction.Triggers>

        <Path Stroke="{Binding SelectedBrush}" StrokeThickness="30" Opacity="0.5"
              ex:PathExtensions.ArrowPoints="{Binding Points}"
              ex:PathExtensions.ArrowSize="{Binding CurrentArrowSize}"
              Fill="{Binding SelectedBrush}"/>
        <!--<Polyline ex:PolylineExtensions.ItemsSource="{Binding Points}"
                  Stroke="Blue" StrokeThickness="3"/>-->
        <!--<Path ex:PathExtensions.ItemsSource="{Binding Points}" Stroke="Blue" StrokeThickness="3"/>-->
        <!--<Polyline Points="{Binding Points}" 
                          Stroke="Blue" 
                          StrokeThickness="2" Panel.ZIndex="99"/>-->


        <ItemsControl ItemsSource="{Binding Points}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Ellipse Width="10" Height="10" Fill="{Binding DataContext.SelectedBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="-5,-5" Cursor="Hand">
                <i:Interaction.Behaviors>
                  <i:MouseDragElementBehavior ConstrainToParentBounds="True"/>
                </i:Interaction.Behaviors>
                <!--<Ellipse.RenderTransform>
                  <TranslateTransform X="-2" Y="-2"/>
                </Ellipse.RenderTransform>-->
              </Ellipse>
            </DataTemplate>
          </ItemsControl.ItemTemplate>

          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
              <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
        <ListBox ItemsSource="{Binding Points}" Height="100" Width="200" Canvas.Left="300">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding X, StringFormat='X: {0:F1}'}"/>
                <TextBlock Text=", "/>
                <TextBlock Text="{Binding Y, StringFormat='Y: {0:F1}'}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Canvas>
    </Border>
  </Grid>


</Window>

