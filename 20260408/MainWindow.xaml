<Window x:Class="_20260408.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260408" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <!--<local:DataThumb x:Name="MyElement" DataContext="{Binding MyData}" />-->
      <local:GeoThumb x:Name="MyElement" DataContext="{Binding MyData}" 
                      />
    </Canvas>

    <StackPanel Grid.Column="1">
      <GroupBox Header="MyData">
        <StackPanel DataContext="{Binding MyData}">
          <TextBlock Text="{Binding Name, StringFormat='Name = {0}'}"/>
          <TextBlock Text="{Binding Points, StringFormat='Points = {0: 0; -0; 0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding X, StringFormat='X = {0:0}'}"/>
          <TextBlock Text="{Binding InternalX, StringFormat='InternalX = {0:0}'}"/>
          <TextBlock Text="{Binding Width, StringFormat='Width = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsWidth, StringFormat='BoundsWidth = {0:0}'}"/>
          <TextBlock Text="{Binding Bounds.Right, StringFormat='BoundsRight = {0:0}'}"/>
          <TextBlock Text="{Binding InternalY, StringFormat='InternalY = {0:0}'}"/>
          <TextBlock Text="{Binding Y, StringFormat='Y = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsHeight, StringFormat='BoundsHeight = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsLeft, StringFormat='BoundsLeft = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsTop, StringFormat='BoundsTop = {0:0}'}"/>
          <TextBlock Text="{Binding Bounds, StringFormat='Bounds = {0: 0; -0; 0}'}"/>
        </StackPanel>
      </GroupBox>
    </StackPanel>
    <StackPanel Grid.Column="2">
      <Button Content="Check" Click="Button_Click_Check"/>
      <Button Content="ChangeGeoDragMove" Click="Button_Click_ChangeDragMove"/>
      <TextBlock Text="{Binding MyData.StrokeThickness, StringFormat=StrokeThickness {0}}"/>
      <Slider Value="{Binding MyData.StrokeThickness}" Minimum="20" Maximum="100" SmallChange="20" LargeChange="20"/>
      <Button Content="Thickness+10" Click="Button_Click_Thickness10"/>
    </StackPanel>
  </Grid>
</Window>