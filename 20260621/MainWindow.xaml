<Window x:Class="_20260621.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260621"
        mc:Ignorable="d"
        Title="MainWindow" Height="167" Width="354"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
  <!--Title="MainWindow" Height="367" Width="654"-->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <!--<local:DrawTextARGB x:Name="MyDraw"/>-->

    <ScrollViewer x:Name="MyScroll"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="MyScroll_ScrollChanged">
      <Grid>
        <Image x:Name="MyImage"
             RenderOptions.BitmapScalingMode="NearestNeighbor">
          <Image.LayoutTransform>
            <ScaleTransform x:Name="MyScaleTransform" ScaleX="{Binding MyScale}" ScaleY="{Binding MyScale}"/>
          </Image.LayoutTransform>
        </Image>
        <local:DrawTextARGB x:Name="MyDraw"
                            MyScroll="{Binding ElementName=MyScroll}"
                            MyImage="{Binding ElementName=MyImage}"
                            MyBitmapSource="{Binding MyBitmap}"
                            MyPixelSize="{Binding ElementName=MyScaleTransform, Path=ScaleX}"/>
      </Grid>
    </ScrollViewer>
    <Canvas x:Name="MyCanvas">

    </Canvas>

    <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding ElementName=MyDraw, Path=ActualHeight, StringFormat='actHeight = {0:0.00}'}"/>
      <TextBlock Text="{Binding ElementName=MyDraw, Path=ActualWidth, StringFormat='actWidth = {0:0.00}'}"/>
      <Slider Value="{Binding MyScale}" Minimum="30" Maximum="100"
              SmallChange="1" LargeChange="1" TickFrequency="1.0"
              IsSnapToTickEnabled="True"/>
      <TextBlock Text="{Binding MyScale}"/>
    </StackPanel>
  </Grid>
</Window>
