<Window x:Class="_20260612.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260612"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer x:Name="MyScroll" HorizontalScrollBarVisibility="Auto">
      <Rectangle x:Name="MyRect" Width="100" Height="100" Fill="red"
                 PreviewMouseLeftButtonDown="MyRect_PreviewMouseLeftButtonDown"
                 MouseMove="MyRect_MouseMove"
                 PreviewMouseWheel="MyRect_PreviewMouseWheel">
        <Rectangle.LayoutTransform>
          <ScaleTransform ScaleX="{Binding MyScale}" ScaleY="{Binding MyScale}"/>
        </Rectangle.LayoutTransform>
      </Rectangle>
    </ScrollViewer>
    <Canvas x:Name="MyCanvas">

    </Canvas>

    <StackPanel Grid.Column="1">
      <Button Content="test1" Click="Button_Click"/>
      <TextBlock Text="{Binding MyX, StringFormat='x = {0}'}"/>
      <TextBlock Text="{Binding MyY, StringFormat='y = {0}'}"/>
      
    </StackPanel>
  </Grid>
</Window>
