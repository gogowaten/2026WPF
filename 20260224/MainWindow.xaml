<Window x:Class="_20260224.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260224"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <local:DiagramBoard x:Name="MyDiagramCanvas"
                           DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Background="Salmon"
                           TargetItems="{Binding RootItem}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           />
    </ScrollViewer>
    <!--<local:DiagramCanvas DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}}" ItemsSource="{Binding RootItem}"/>-->

    <Canvas x:Name="MyCanvas"/>
    <StackPanel Grid.Column="1">
      <Button Content="test" Click="Button_Click"/>
      <Button x:Name="SaveButton" Content="画像として保存" Click="SaveButton_Click" Margin="10" Padding="10,5"/>
      <TextBlock Text="AAAAAAAA" Background="Red"/>
      <TextBox Text="BBBBBBB" Background="Gold"/>
      <Polyline Points="0,0 100, 20" Stroke="Blue" Fill="Cyan" StrokeThickness="20"/>
      <TextBlock Text="{Binding ElementName=MyDiagramCanvas, Path=Width}"/>
    </StackPanel>
  </Grid>
</Window>
