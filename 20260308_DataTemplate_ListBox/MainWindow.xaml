<Window x:Class="_20260308_DataTemplate_ListBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260308_DataTemplate_ListBox" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">

  <Window.Resources>
    
    <Style x:Key="CanvasItemContainerStyle" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding X}" />
      <Setter Property="Canvas.Top" Value="{Binding Y}" />
      <!--<Setter Property="Panel.ZIndex" Value="{Binding Z}" />-->
    </Style>

    <!--IsSelectedを普通にバインド-->
    <Style x:Key="ListBoxItemContainerStyle" TargetType="ListBoxItem">
      <Setter Property="Canvas.Left" Value="{Binding X}" />
      <Setter Property="Canvas.Top" Value="{Binding Y}" />
      <!--<Setter Property="Panel.ZIndex" Value="{Binding Z}" />-->
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
    </Style>




    <!-- #region ItemsControlDataTemplate -->


    <DataTemplate DataType="{x:Type local:GroupData}">
      <ItemsControl ItemsSource="{Binding DataList}"
                    ItemContainerStyle="{StaticResource CanvasItemContainerStyle}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas IsItemsHost="True"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>


    <DataTemplate DataType="{x:Type local:RectangleData}">
      <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:EllipseData}">
      <Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </DataTemplate>
    <!-- #endregion ItemsControlDataTemplate -->
  </Window.Resources>

  <Grid>
    
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="240"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <!--IsSelectedを普通にバインドすると、
      SelectionModeをExtendedやMultipleにしても複数選択可能にならない-->
      <ListBox ItemsSource="{Binding MyGroupData.DataList}"
                ItemContainerStyle="{StaticResource ListBoxItemContainerStyle}"
                PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                SelectionMode="Multiple">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas IsItemsHost="True"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Template>
          <ControlTemplate>
            <ItemsPresenter/>
          </ControlTemplate>
        </ListBox.Template>
      </ListBox>
    </Canvas>


    <StackPanel Grid.Column="1">
      <ListBox ItemsSource="{Binding MyGroupData.DataList}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Height="20">
              <Viewbox>
                <ContentControl Content="{Binding}"/>
              </Viewbox>
              <TextBlock Text="{Binding X, StringFormat='Left = {0:0.0}'}"/>
              <TextBlock Text="{Binding Y, StringFormat=', Top = {0:0.0}'}"/>
              <TextBlock Text="{Binding IsSelected}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Slider Minimum="0" Maximum="200" Value="{Binding MyGroupData.DataList[0].X}"/>

      <Grid>
        <Grid.Resources>
          <!--TreeView用のDataTemplate、Type指定が他のDataTemplateと重なるとエラーになるので、Keyを指定している-->
          <HierarchicalDataTemplate DataType="{x:Type local:GroupData}" 
                                  ItemsSource="{Binding DataList}">
            <StackPanel Orientation="Horizontal">
              <Viewbox>
                <ContentControl Content="{Binding DataList}"/>
              </Viewbox>
              <TextBlock Text="📁 " Foreground="Goldenrod"/>
              <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
              <TextBlock Text="{Binding DataList.Count, StringFormat=' ({0} items)'}" 
                           Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
          </HierarchicalDataTemplate>
          <DataTemplate DataType="{x:Type local:RectangleData}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Height="20">
                <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
              </Viewbox>
              <TextBlock Text="Rectangle"/>
              <TextBlock Text="{Binding X, StringFormat=' (X:{0:F0},'}" Foreground="Gray" Margin="5,0,0,0"/>
              <TextBlock Text="{Binding Y, StringFormat=' Y:{0:F0})'}" Foreground="Gray"/>
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="{x:Type local:EllipseData}">
            <Viewbox Height="20">
              <Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
            </Viewbox>
          </DataTemplate>

          <!--<DataTemplate DataType="{x:Type local:EllipseData}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="○ " Foreground="DodgerBlue" FontWeight="Bold"/>
              <TextBlock Text="Ellipse"/>
              <TextBlock Text="{Binding X, StringFormat=' (X:{0:F0},'}" Foreground="Gray" Margin="5,0,0,0"/>
              <TextBlock Text="{Binding Y, StringFormat=' Y:{0:F0})'}" Foreground="Gray"/>
            </StackPanel>
          </DataTemplate>-->

          <!--<DataTemplate DataType="{x:Type local:RectangleData}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="□ " Foreground="Tomato" FontWeight="Bold"/>
              <TextBlock Text="Rectangle"/>
              <TextBlock Text="{Binding X, StringFormat=' (X:{0:F0},'}" Foreground="Gray" Margin="5,0,0,0"/>
              <TextBlock Text="{Binding Y, StringFormat=' Y:{0:F0})'}" Foreground="Gray"/>
            </StackPanel>
          </DataTemplate>-->
        </Grid.Resources>

        <TreeView ItemsSource="{Binding MyGroupData.DataList}">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
              <Setter Property="IsExpanded" Value="True"/>
            </Style>
          </TreeView.ItemContainerStyle>
        </TreeView>
      </Grid>

    </StackPanel>
  </Grid>
</Window>