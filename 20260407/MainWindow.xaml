<Window x:Class="_20260407.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260407" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <local:DataThumb x:Name="MyElement" DataContext="{Binding MyData}" />
    </Canvas>

    <StackPanel Grid.Column="1">
      <GroupBox Header="TestThumb" DataContext="{Binding ElementName=MyElement}">
        <StackPanel>
          <TextBlock Text="{Binding ActualHeight, StringFormat='ActualHeight = {0}'}"/>
          <TextBlock Text="{Binding ActualWidth, StringFormat='ActualWidth = {0}'}"/>
          <TextBlock Text="{Binding (Canvas.Left), StringFormat='CanvasLeft = {0}'}"/>
          <TextBlock Text="{Binding (Canvas.Top), StringFormat='CanvasTop = {0}'}"/>
        </StackPanel>
      </GroupBox>
    </StackPanel>
    <StackPanel Grid.Column="2">
      <Button Content="Check" Click="Button_Click_Check"/>
      <Button Content="ChangeGeoDragMove" Click="Button_Click_ChangeDragMove"/>
      <Slider Value="{Binding MyData.StrokeThickness}" Minimum="10" Maximum="50"/>
      <Button Content="Thickness+10" Click="Button_Click_Thickness10"/>
      <GroupBox Header="MyData">
        <StackPanel DataContext="{Binding MyData}">
          <TextBlock Text="{Binding Name, StringFormat='Name = {0}'}"/>
          <TextBlock Text="{Binding Points, StringFormat='Points = {0: 0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding InternalX, StringFormat='InternalX = {0:0}'}"/>
          <TextBlock Text="{Binding InternalY, StringFormat='InternalY = {0:0}'}"/>
          <TextBlock Text="{Binding X, StringFormat='X = {0:0}'}"/>
          <TextBlock Text="{Binding Y, StringFormat='X = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsHeight, StringFormat='BoundsHeight = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsWidth, StringFormat='BoundsWidth = {0:0}'}"/>
          <TextBlock Text="{Binding Width, StringFormat='Width = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsLeft, StringFormat='BoundsLeft = {0:0}'}"/>
          <TextBlock Text="{Binding BoundsTop, StringFormat='BoundsTop = {0:0}'}"/>
        </StackPanel>
      </GroupBox>
    </StackPanel>
  </Grid>
</Window>