<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260407">



  <Style TargetType="{x:Type local:DataThumb}">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Width" Value="{Binding Width}"/>
    <Setter Property="Height" Value="{Binding Height}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DataThumb}">
          <Canvas Width="{Binding Width}"
                  Height="{Binding Height}"
                  Background="Gold">
            <local:InternalThumb/>
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style TargetType="{x:Type local:InternalThumb}">
    <Setter Property="Canvas.Left" Value="{Binding InternalX}"/>
    <Setter Property="Canvas.Top" Value="{Binding InternalY}"/>
    <Setter Property="IsCanDragMove" Value="{Binding IsCanDragMove}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:InternalThumb}">
          <local:GeoLine x:Name="GeoLine"
                         MyPoints="{Binding Points}"
                         Fill="{Binding Fill}"
                         Stroke="{Binding Stroke}"
                         StrokeThickness="{Binding StrokeThickness}"
                         StrokeEndLineCap="{Binding EndLineCap}"
                         StrokeStartLineCap="{Binding StartLineCap}"
                         StrokeLineJoin="{Binding LineJoin}"
                         StrokeMiterLimit="{Binding MiterLimit}"
                         MyIsOffset="{Binding IsOffset}"
                           
                         />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>



