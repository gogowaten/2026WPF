<UserControl x:Class="_20260217.MyNumeUD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_20260217"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
  <UserControl.Resources>
    <local:MyConvDecimalText x:Key="dt"/>
    <local:MyConvDT x:Key="mydt"/>
  </UserControl.Resources>
  <Border BorderBrush="Gray" BorderThickness="1">

    <DockPanel>
      <TextBlock DockPanel.Dock="Left"
                 VerticalAlignment="Center" Margin="5,0,0,0"
                 Text="{Binding RelativeSource={RelativeSource AncestorType=local:MyNumeUD}, Path=MyPrefix}"
                 PreviewMouseLeftButtonDown="TextBlock_PreviewMouseLeftButtonDown"/>
      <Grid DockPanel.Dock="Right"
            Width="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <RepeatButton x:Name="btnUp" Grid.Row="0"
                      Background="Transparent" BorderBrush="Transparent"
                      Click="btnUp_Click">
          <Viewbox Width="8" Height="8">
            <Path Data="M 0,5 L 5,0 L 10,5 Z"
                  Fill="Blue"/>
          </Viewbox>
        </RepeatButton>
        <RepeatButton x:Name="btnDown" Grid.Row="1"
                      Background="Transparent" BorderBrush="Transparent"
                      Click="btnDown_Click">
          <Viewbox Width="8" Height="8">
            <Path Data="M 0,0 L 10,0 L 5,5 Z"
                  Fill="Blue"/>
          </Viewbox>
        </RepeatButton>
      </Grid>
      <TextBlock  DockPanel.Dock="Right"
                 Text="{Binding RelativeSource={RelativeSource AncestorType=local:MyNumeUD}, Path=MySuffix}"
                 VerticalAlignment="Center"
                  PreviewMouseLeftButtonDown="TextBlock_PreviewMouseLeftButtonDown"/>

      <TextBox x:Name="txtValue" DockPanel.Dock="Right" BorderThickness="0"
               PreviewMouseLeftButtonDown="txtValue_PreviewMouseLeftButtonDown"
               Background="Transparent"
               VerticalContentAlignment="Center"
               TextChanged="txtValue_TextChanged"
               PreviewTextInput="txtValue_PreviewTextInput"
               PreviewKeyDown="txtValue_PreviewKeyDown"
               LostFocus="txtValue_LostFocus"
               PreviewMouseWheel="txtValue_PreviewMouseWheel"
               FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}"
               Padding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Padding}"
               TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MyNumeUD}, Path=MyTextAlignment}">
      
      </TextBox>
      
      <!--<TextBox x:Name="txtValue" DockPanel.Dock="Right" BorderThickness="0"
               
               Background="Transparent"
               VerticalContentAlignment="Center"
               TextChanged="txtValue_TextChanged"
               PreviewTextInput="txtValue_PreviewTextInput"
               PreviewKeyDown="txtValue_PreviewKeyDown"
               LostFocus="txtValue_LostFocus"
               PreviewMouseWheel="txtValue_PreviewMouseWheel"
               FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}"
               Padding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Padding}">
        <TextBox.Text>
          <MultiBinding Converter="{StaticResource mydt}" UpdateSourceTrigger="PropertyChanged">
            <Binding RelativeSource="{RelativeSource AncestorType=local:MyNumeUD}" Path="Value"/>
            <Binding RelativeSource="{RelativeSource AncestorType=local:MyNumeUD}" Path="MyDecimals"/>
          </MultiBinding>
        </TextBox.Text>
      </TextBox>-->

      <!--<TextBox x:Name="txtValue" DockPanel.Dock="Right" BorderThickness="0"
               Text="{Binding RelativeSource={RelativeSource AncestorType=local:MyNumeUD}, Path=Value, Converter={StaticResource dt}, UpdateSourceTrigger=PropertyChanged}"
               Background="Transparent"
               VerticalContentAlignment="Center"
               TextChanged="txtValue_TextChanged"
               PreviewTextInput="txtValue_PreviewTextInput"
               PreviewKeyDown="txtValue_PreviewKeyDown"
               LostFocus="txtValue_LostFocus"
               PreviewMouseWheel="txtValue_PreviewMouseWheel"
               FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}"
               Padding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Padding}"/>-->



      <!--フォントサイズを外部から指定できるようにする-->



    </DockPanel>


  </Border>
</UserControl>
