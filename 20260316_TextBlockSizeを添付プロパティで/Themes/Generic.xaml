<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260316_TextBlockSizeを添付プロパティで">


  <DataTemplate DataType="{x:Type local:TextBlockData}">
    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontFamily="{Binding FontName}"
               local:SizeObserver.Observe="True"
               local:SizeObserver.ObserveHeight="{Binding Height, Mode=OneWayToSource}"
               local:SizeObserver.ObserveWidth="{Binding Width, Mode=OneWayToSource}"
               />
  </DataTemplate>


  <Style TargetType="{x:Type local:TestControl}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TestControl}">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>



</ResourceDictionary>