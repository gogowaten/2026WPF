<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260426"
  
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        mc:Ignorable="d"

  >

  <!-- #region これは一番上に書く必要がある -->  

  <Style x:Key="CanvasItemContaier">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>

  <!-- #endregion これは一番上に書く必要がある -->


  <DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:CustomThumb>
      <local:GeoThumb/>
    </local:CustomThumb>
  </DataTemplate>

  <!--<DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:CanvasThumb/>
  </DataTemplate>-->

  
  
  <Style TargetType="{x:Type local:CanvasThumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CanvasThumb}">
          <Canvas x:Name="PART_Canvas" Background="PowderBlue">
            <local:GeoThumb/>
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type local:GeoThumb}">
    <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.InternalX}"/>
    <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.InternalY}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GeoThumb}">
          <local:GeoLine x:Name="PART_GeoLine" d:DataContext="{d:DesignInstance Type=local:GeoLineData}"
                         MyPoints="{Binding Points}"
                         Fill="{Binding Fill}"
                         Stroke="{Binding Stroke}"
                         StrokeThickness="{Binding StrokeThickness}"
                         StrokeEndLineCap="{Binding StrokeEndLineCap}"
                         StrokeStartLineCap="{Binding StrokeStartLineCap}"
                         StrokeLineJoin="{Binding StrokeLineJoin}"
                         StrokeMiterLimit="{Binding StrokeMiterLimit}"
                         />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  
  <DataTemplate DataType="{x:Type local:EllipseData}">
    <Ellipse Width="{Binding Width}"
             Height="{Binding Height}"
             Fill="{Binding Fill}"/>
  </DataTemplate>
  
  <DataTemplate DataType="{x:Type local:GroupData}">
    <local:CustomThumb>
      <Grid d:DataContext="{d:DesignInstance Type=local:GroupData}">
        <Rectangle Stroke="Blue" StrokeThickness="1" StrokeDashArray="2,2"/>
        <ItemsControl ItemsSource="{Binding DataList}"
                      Width="{Binding Width}"
                      Height="{Binding Height}"
                      Background="Transparent"
                      ItemContainerStyle="{StaticResource CanvasItemContaier}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </local:CustomThumb>
  </DataTemplate>


  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}"/>
            <Border x:Name="SelectedBorder" Visibility="Collapsed"
                    BorderBrush="Orange" BorderThickness="1"
                    Margin="-10"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>





  <Style TargetType="{x:Type local:RootItemsControl}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource CanvasItemContaier}"/>
    <Setter Property="ItemsSource" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.DataList}"/>

    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RootItemsControl}">
          <Grid Background="WhiteSmoke" d:DataContext="{d:DesignInstance Type=local:RootData}">
            <ItemsPresenter x:Name="MyPresenter"
                            Width="{Binding Width}"
                            Height="{Binding Height}"/>
            <Border BorderBrush="Orange" BorderThickness="0" Margin="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

  </Style>





</ResourceDictionary>
