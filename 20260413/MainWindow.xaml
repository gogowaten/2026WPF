<Window x:Class="_20260413.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260413"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <Thumb x:Name="MyCanvasThumb" Canvas.Left="30" Canvas.Top="10">
        <Thumb.Template>
          <ControlTemplate>
            <Canvas x:Name="MyIntrenalCanvas"
                    Background="Red" Width="100" Height="100">
              
            </Canvas>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Canvas>

    <StackPanel Grid.Column="1">
      <GroupBox Header="CanvasThumb" DataContext="{Binding ElementName=MyCanvasThumb}">
        <StackPanel>
          <TextBlock Text="{Binding ActualHeight, StringFormat='ActualHeight ={0:0}'}"/>
        </StackPanel>
      </GroupBox>
      
    </StackPanel>
  </Grid>
</Window>
