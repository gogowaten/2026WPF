<Window x:Class="TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestApp"
        xmlns:ll="clr-namespace:_20260213_WpfControlLibrary1;assembly=20260213_WpfControlLibrary1"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="300">
  <Grid UseLayoutRounding="True">
    <StackPanel>
    <ll:MyNumericUpDown Width="180" Height="24" Minimum="-50" Maximum="15000" Padding="0" Value="5000" FontSize="15"
                        MyMarkerColor="Black" Margin="0,20,0,0"
                        MyFontColor="Red" Foreground="Black"
                        MyButtonWidth="30" MyBorderThickness="2" BorderBrush="Black"
                        ValueChanged="MyNumericUpDown_ValueChanged"
                        Step="3"
                        Decimals="0"
                        Prefix="" Suffix="兆円欲しい！"
                        />
      <ll:MyNumericUpDown Width="220"
                          Padding="0" Margin="10"
                          Background="MintCream"
                          MyBorderThickness="1"
                          BorderBrush="DodgerBlue"
                          Maximum="100000"
                          Decimals="1"
                          Prefix="時速；"
                          Suffix="km/h"
                          />
      <ll:MyNumericUpDown Width="150" Decimals="5" Value="-1.23456"
                          FontSize="30" MyMarkerColor="Magenta" MyFontColor="Magenta"/>
      
      <!--<DockPanel Width="210" MinWidth="100">
        <TextBlock DockPanel.Dock="Left" Text="てすと" Background="Beige"/>
        <TextBlock DockPanel.Dock="Right" Text="てすと" Background="Salmon" Width="20"/>
        <TextBlock DockPanel.Dock="Right" Text="てすと" Background="DodgerBlue"/>
        <TextBox DockPanel.Dock="Right" Text="てすと" Background="MediumAquamarine"/>
      </DockPanel>-->
    </StackPanel>
  </Grid>
</Window>
