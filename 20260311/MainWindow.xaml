<Window x:Class="_20260311.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260311" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="567" Width="654">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Left" VerticalAlignment="top">
      <local:AAAItemsCtrl x:Name="MyAAA" DataContext="{Binding MyDataVM}" MyRootData="{Binding}"/>
      <!--<local:AAAItemsCtrl x:Name="MyAAA" DataContext="{Binding MyDataVM}"
                        AAADataService="{Binding MyService}"/>-->
    </ScrollViewer>

    <!--<local:CustomThumb>
      <local:TTTextBlock x:Name="MyTTText" Text="aaaaaaa" Background="Yellow"/>

    </local:CustomThumb>-->


    <StackPanel Grid.Column="1" DataContext="{Binding MyDataVM}">
      <Button Content="test" Click="Button_Click"/>
      <Button Content="updateSize" Command="{Binding UpdateSizeCommand}"/>
      <TextBox Text="{Binding AddText, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="TextBlockを追加" Command="{Binding AddTextBlockDataCommand}" CommandParameter="{Binding Path=AddText}"/>
      <Button Content="選択Itemを削除" Command="{Binding RemoveSelectedItemsCommand}"/>
      <Button Content="age" Command="{Binding ZAgeCommand}"/>
      <!--<Button Content="右へ10移動" Command="{Binding ToRightCommand}"/>-->
      <TextBlock Text="{Binding Width, StringFormat=RootWidth {0}}"/>
      <TextBlock Text="{Binding CurrentItem.Name, StringFormat=CurrentItem {0}}"/>
      <TextBlock Text="{Binding CurrentItem.Width, StringFormat=CurrentItem.Width {0:0.0}}"/>
      <TextBlock Text="{Binding ClickedItem.Name, StringFormat=ClickedItem {0}}"/>
      <TextBlock Text="{Binding ClickedItem.ParentData.Name, StringFormat=ClickedItem.ParentData {0}}"/>
      <TextBlock Text="{Binding EditingGroup.Name, StringFormat=EditingGroup {0}}"/>
      <TextBlock Text="{Binding SelectedItems.Count, StringFormat=SelectedItemsCount {0}}"/>
      <Viewbox Height="30">
        <ContentPresenter Content="{Binding CurrentItem}"/>
      </Viewbox>
      <ListBox ItemsSource="{Binding SelectedItems}" IsHitTestVisible="False">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Viewbox Height="50" Width="50">
              <ContentPresenter Content="{Binding}"/>
            </Viewbox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TreeView ItemsSource="{Binding DataList}">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
          </Style>
        </TreeView.ItemContainerStyle>

        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate DataType="{x:Type local:GroupData}" ItemsSource="{Binding DataList}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}"/>
              <TextBlock Text="{Binding Z, StringFormat='  = {0}'}"/>
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

    </StackPanel>
  </Grid>
</Window>