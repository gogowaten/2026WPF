<Window x:Class="_20260311.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260311" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <local:AAAItemsCtrl x:Name="MyAAA" DataContext="{Binding MyDataVM}" MyRootData="{Binding}"/>
    <!--<local:AAAItemsCtrl x:Name="MyAAA" DataContext="{Binding MyDataVM}"
                        AAADataService="{Binding MyService}"/>-->







    <StackPanel Grid.Column="1" DataContext="{Binding MyDataVM}">
      <Button Content="test" Click="Button_Click"/>
      <!--<Button Content="右へ10移動" Command="{Binding ToRightCommand}"/>-->
      <TextBlock Text="{Binding CurrentItem.Name, StringFormat=CurrentItem {0}}"/>
      <TextBlock Text="{Binding EditingGroup.Name, StringFormat=EditingGroup {0}}"/>
      <TextBlock Text="{Binding SelectedItems.Count, StringFormat=SelectedItemsCount {0}}"/>
      <ContentPresenter Content="{Binding CurrentItem}"/>
      <TreeView ItemsSource="{Binding DataList}">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
          </Style>
        </TreeView.ItemContainerStyle>

        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate DataType="{x:Type local:GroupData}" ItemsSource="{Binding DataList}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}"/>
              <TextBlock Text="{Binding IsSelected, StringFormat=' _ 選択状態 = {0}'}"/>
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

    </StackPanel>
  </Grid>
</Window>