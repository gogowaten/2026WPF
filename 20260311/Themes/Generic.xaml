<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260311">



  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <!--<Setter Property="MyIsCurrent" Value="{Binding IsCurrent}"/>-->
    <!--<Setter Property="MyIsSelected" Value="{Binding IsSelected}"/>-->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}"/>
            <Border x:Name="SelectedBorder" Visibility="Collapsed" BorderBrush="Orange" BorderThickness="1" Margin="-10"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="CanvasItemContainer">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>


  <DataTemplate DataType="{x:Type local:TextBlockData}">
    <local:CustomThumb>
      <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontFamily="{Binding FontName}"
                 Foreground="{Binding Foreground}" Background="{Binding Background}"
                 Opacity="0.5"
                         local:SizeObserver.Observe="True"
                         local:SizeObserver.ObservedWidth="{Binding Width, Mode=OneWayToSource}"
                         local:SizeObserver.ObservedHeight="{Binding Height, Mode=OneWayToSource}"
/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:RectangleData}">
    <local:CustomThumb>
      <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:EllipseData}">
    <local:CustomThumb>
      <Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:GroupData}">
    <local:CustomThumb>
      <Grid>
        <Rectangle Stroke="Blue" StrokeThickness="1" StrokeDashArray="2,2"/>
        <!--<Border Background="Transparent" BorderBrush="Red" BorderThickness="10"/>-->
        <ItemsControl ItemsSource="{Binding DataList}"
                    Width="{Binding Width}" Height="{Binding Height}"
                    Background="Transparent"
                    ItemContainerStyle="{StaticResource CanvasItemContainer}">

          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

      </Grid>
    </local:CustomThumb>
  </DataTemplate>



