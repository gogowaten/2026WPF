<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260311">

 

  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <Setter Property="MyIsSelected" Value="{Binding IsSelected}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <ContentPresenter Content="{TemplateBinding MyContent}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="CanvasItemContainer">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
  </Style>


  <DataTemplate DataType="{x:Type local:RectangleData}">
    <local:CustomThumb>
      <Rectangle Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:EllipseData}">
    <local:CustomThumb MyIsSelected="{Binding IsSelected}">
      <Ellipse Width="{Binding Width}" Height="{Binding Height}" Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:GroupData}">
    <local:CustomThumb>
      <ItemsControl ItemsSource="{Binding DataList}"
                    Width="200" Height="200"
                    Background="Transparent" BorderBrush="Red" BorderThickness="1"
                    ItemContainerStyle="{StaticResource CanvasItemContainer}">

        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas IsItemsHost="True"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </local:CustomThumb>
  </DataTemplate>



