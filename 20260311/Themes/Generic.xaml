<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260311"
  xmlns:i="http://schemas.microsoft.com/xaml/behaviors">


  <DataTemplate DataType="{x:Type local:GeoLineData2}">
    <local:CustomThumb>
      <local:GeoCanvas MyGeoData="{Binding}"
                       Width="{Binding Width}"
                       Height="{Binding Height}"
                       Background="#2552"/>
    </local:CustomThumb>
  </DataTemplate>


  <Style TargetType="{x:Type local:CustomThumbForInternal}">
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding InternalX}"/>
    <Setter Property="Canvas.Top" Value="{Binding InternalY}"/>
    <Setter Property="IsCanDragMove" Value="{Binding IsCanDragMove}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumbForInternal}">
          <Canvas x:Name="InternalCanvas" Width="{Binding Width}"
                  Height="{Binding Height}">
            <local:GeoLine x:Name="GeoLine"
                           
                           MyPoints="{Binding Points}"
                           Stroke="{Binding Stroke}"
                           StrokeThickness="{Binding StrokeThickness}"
                           Fill="{Binding Fill}"
                           StrokeEndLineCap="{Binding EndLineCap}"
                           StrokeStartLineCap="{Binding StartLineCap}"
                           StrokeLineJoin="{Binding LineJoin}"
                           StrokeMiterLimit="{Binding MiterLimit}"
                           MyIsOffset="{Binding IsOffset}"
                           
                           />


            <Border BorderBrush="Black" BorderThickness="2" Opacity="0.8"
                    Width="{Binding BoundsWidth}"
                    Height="{Binding BoundsHeight}"
                    Canvas.Left="0"
                    Canvas.Top="0"/>

            <Border BorderBrush="Cyan" BorderThickness="1" Opacity="0.8"
                    Width="{Binding  MyActualWidth}"
                    Height="{Binding MyActualHeight}"
                    Canvas.Left="0"
                    Canvas.Top="0"/>

            <Border BorderBrush="DarkViolet" BorderThickness="1" Opacity="0.8"
                    Width="{Binding MyActualWidth}"
                    Height="{Binding MyActualHeight}"
                    Canvas.Left="{Binding BoundsLeft}"
                    Canvas.Top="{Binding BoundsTop}"/>

            <Border BorderBrush="Red" BorderThickness="1" Opacity="0.8"
                    Width="{Binding BoundsWidth}"
                    Height="{Binding BoundsHeight}"
                    Canvas.Left="{Binding BoundsLeft}"
                    Canvas.Top="{Binding BoundsTop}"/>

            <Border BorderBrush="Yellow" BorderThickness="1" Opacity="0.9"
                    Width="{Binding GeoWidth}"
                    Height="{Binding GeoHeight}"
                    Canvas.Left="{Binding GeoLeft}"
                    Canvas.Top="{Binding GeoTop}"/>

          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  
  

  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <!--<Setter Property="MyIsCurrent" Value="{Binding IsCurrent}"/>-->
    <!--<Setter Property="MyIsSelected" Value="{Binding IsSelected}"/>-->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}"/>
            <Border x:Name="SelectedBorder" Visibility="Collapsed" BorderBrush="Orange" BorderThickness="1" Margin="-10"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="CanvasItemContainer">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>

  <DataTemplate DataType="{x:Type local:GeoShapeData}">
    <local:CustomThumb>
      <Canvas Width="{Binding ElementName=geoShape, Path=ActualWidth}"
              Height="{Binding ElementName=geoShape, Path=ActualHeight}"
              Background="{Binding Background}">
        <local:GeoShape x:Name="geoShape"
                        Points="{Binding Points}"
                       Stroke="{Binding Stroke}"
                       StrokeThickness="{Binding StrokeThickness}"
                        Fill="{Binding Fill}"
                       StrokeEndLineCap="{Binding StrokeEndLineCap}"
                       StrokeStartLineCap="{Binding StrokeStartLineCap}"
                       StrokeMiterLimit="{Binding StrokeMiterLimit}"
                       StrokeLineJoin="{Binding StrokeLineJoin}"
                        IsOffset="{Binding IsOffset}"
                        RenderBounds="{Binding Bounds, Mode=OneWayToSource}"
                        OriginRenderBounds="{Binding OriginBounds, Mode=OneWayToSource}"
                        local:SizeObserver.Observe="True"
                        local:SizeObserver.ObservedWidth="{Binding Width, Mode=OneWayToSource}"
                        local:SizeObserver.ObservedHeight="{Binding Height, Mode=OneWayToSource}"
                     >
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
              <i:InvokeCommandAction Command="{Binding RelativeSource={RelativeSource AncestorType=local:GeoShape}, Path=UpdateRenderBoundsCommand}"/>
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </local:GeoShape>
      </Canvas>
    </local:CustomThumb>
  </DataTemplate>


