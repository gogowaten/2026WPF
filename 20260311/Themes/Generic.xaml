  <Style TargetType="{x:Type local:AAAItemsCtrl}">
    <Setter Property="ItemsSource" Value="{Binding DataList}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CanvasItemContainer}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AAAItemsCtrl}">
          <Grid Background="WhiteSmoke">
            <ItemsPresenter Width="{Binding Width}" Height="{Binding Height}"/>
            <Border BorderBrush="Orange" BorderThickness="0" Margin="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <!--<Setter Property="ItemContainerStyle">
      <Setter.Value>
