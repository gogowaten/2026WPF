<Window x:Class="_20260212_Behaviors.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:_20260212_Behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
  <Grid UseLayoutRounding="True">
    <Border Width="200" Height="100" BorderBrush="Black" BorderThickness="1">
      <i:Interaction.Behaviors>
        <local:MouseOverBehavior/>
      </i:Interaction.Behaviors>
      <TextBlock Text="ここにマウスを乗せると色が変化する" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
