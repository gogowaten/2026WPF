<Window x:Class="_20260318_01_CanExecute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260318_01_CanExecute"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Window.DataContext>
    <local:Class1/>
  </Window.DataContext>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">

    </Canvas>

    <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding Id, StringFormat='Id = {0:0}'}"/>
      <Button Content="age" Command="{Binding AgeCommand}" Height="30" Margin="10"/>
      <Button Content="sage" Command="{Binding SageCommand}" Height="30" Margin="10"/>
    </StackPanel>
  </Grid>
</Window>
