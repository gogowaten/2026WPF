<Window x:Class="_20260420_03_VertexHandle_CanvasGeoThumb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260420_03_VertexHandle_CanvasGeoThumb" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="467" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <!--<local:GeoLine MyPoints="0,0 100,100" Stroke="Red"/>-->
      <!--<local:GeoThumb x:Name="MyElement" DataContext="{Binding MyData}"/>-->

      <local:CanvasThumb x:Name="MyElement" DataContext="{Binding MyData}" Width="200" Height="200"/>

    </Canvas>

    <StackPanel Grid.Column="1">
      <Button Content="Check" Click="Button_Click_Check"/>
      <Button Content="Add" Click="Button_Click_Add"/>
      <Button Content="Clear" Click="Button_Click_Clear"/>
      <Button Content="StrokeColor" Click="Button_Click_StrokeColor"/>
      <Button Content="ChangeResize" Click="Button_Click_ChangeResize"/>
      <Button Content="頂点ハンドル表示" Click="Button_Click_VertexHandle"/>
      <Button Content="頂点ハンドル非表示" Click="Button_Click_VertexHandleHide"/>
      <Button Content="頂点ハンドル更新" Click="Button_Click_UpdateVertexHandles"/>
      <Button Content="図形にピッタリ" Click="Button_Click_PerfectlyFit"/>

      <GroupBox Header="Data" DataContext="{Binding MyData}">
        <StackPanel>
          <TextBlock Text="{Binding BoundsWidth, StringFormat='BoundsWidth = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding InternalX, StringFormat='InternalX = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding Width, StringFormat='Width = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding MyPoints, StringFormat='MyPoints = {0: 0; -0; 0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding VertexHandleSize, StringFormat='VertexHandleSize = {0: 0; -0; 0}'}"/>
          <Slider Value="{Binding VertexHandleSize}" Minimum="10" Maximum="50" SmallChange="10" LargeChange="10"/>
        </StackPanel>
      </GroupBox>

      <!--<GroupBox Header="MyElement_MyGeoLine" DataContext="{Binding ElementName=MyElement}">
        <StackPanel>
          <TextBlock Text="{Binding ActualWidth, StringFormat='ActualWidth = {0: 0; -0; 0}'}"/>
        </StackPanel>
      </GroupBox>-->

      <GroupBox Header="MyElement" DataContext="{Binding ElementName=MyElement}">
        <StackPanel>
          <TextBlock Text="{Binding ActualWidth, StringFormat='ActualWidth = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding Width, StringFormat='Width = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding ResizeHandleSize, StringFormat='ResizeHandleSize = {0: 0; -0; 0}'}"/>
          <Slider Value="{Binding ResizeHandleSize}"
        Minimum="10" Maximum="50" SmallChange="10" LargeChange="10"/>

        </StackPanel>
      </GroupBox>

    </StackPanel>
  </Grid>
</Window>