<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260424">


  

  <DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:CanvasThumb/>
  </DataTemplate>

  <Style TargetType="{x:Type local:CanvasThumb}">

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CanvasThumb}">
          <Canvas x:Name="PART_Canvas" Background="PowderBlue">
            <local:GeoThumb/>
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style TargetType="{x:Type local:GeoThumb}">
    <Setter Property="Canvas.Left" Value="{Binding InternalX, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding InternalY, Mode=TwoWay}"/>
    <Setter Property="MyVisibleVertexHandle" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.IsVisibleVertexHandles}"/>
    <Setter Property="MyShapeVertexHandleSize" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.VertexHandleSize, Mode=TwoWay}"/>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GeoThumb}">

          <local:GeoLine x:Name="PART_GeoLine"
                           MyPoints="{Binding MyPoints}"
                           Fill="{Binding Fill}"
                           Stroke="{Binding Stroke}"
                           StrokeThickness="{Binding StrokeThickness}"
                           StrokeEndLineCap="{Binding EndLineCap}"
                           StrokeStartLineCap="{Binding StartLineCap}"
                           StrokeLineJoin="{Binding LineJoin}"
                           StrokeMiterLimit="{Binding MiterLimit}"
                               />

        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>



  <Style TargetType="{x:Type local:FlatHandle}">
    <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyLeft, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyTop, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FlatHandle}">
          <Grid Background="{TemplateBinding MyFillBrush}">
            <Rectangle Stroke="Black" StrokeThickness="1"/>
            <Rectangle Stroke="White" StrokeThickness="1" StrokeDashArray="2,2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>




  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <!--<Setter Property="MyIsCurrent" Value="{Binding IsCurrent}"/>-->
    <!--<Setter Property="MyIsSelected" Value="{Binding IsSelected}"/>-->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}"/>
            <Border x:Name="SelectedBorder" Visibility="Collapsed" BorderBrush="Orange" BorderThickness="1" Margin="-10"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="CanvasItemContainer">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>


  <DataTemplate DataType="{x:Type local:GroupData}">
    <local:CustomThumb>
      <Grid>
        <Rectangle Stroke="Blue" StrokeThickness="1" StrokeDashArray="2,2"/>
        <ItemsControl ItemsSource="{Binding DataList}"
                      Width="{Binding Width}"
                      Height="{Binding Height}"
                      Background="Transparent"
                      ItemContainerStyle="{StaticResource CanvasItemContainer}">

          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

      </Grid>
    </local:CustomThumb>
  </DataTemplate>




  <Style TargetType="{x:Type local:AAAItemsCtrl}">
    <!--<Setter Property="ItemsSource" Value="{Binding DataList}"/>-->
    <Setter Property="ItemsSource" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyRootData.DataList}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CanvasItemContainer}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:AAAItemsCtrl}">
          <Grid Background="WhiteSmoke">
            <ItemsPresenter x:Name="MyPresenter" Width="{Binding Width}" Height="{Binding Height}"/>
            <Border BorderBrush="Orange" BorderThickness="0" Margin="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <!--<Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ItemsControl">
          <Setter Property="Background" Value="Black"/>
          <Setter Property="BorderBrush" Value="Aqua"/>
          <Setter Property="BorderThickness" Value="20"/>
        </Style>
      </Setter.Value>
    </Setter>-->

  </Style>



</ResourceDictionary>
