<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260505"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">



  <!-- #region これは一番上に書く必要がある -->

  <Style x:Key="CanvasItemContaier">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>

  <!-- #endregion これは一番上に書く必要がある -->


  
  
  
  <DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:CustomThumb>
      <!--MyData="{Binding}"-->
      <local:GeoLineEX 
        MyPoints="{Binding Points, Mode=TwoWay}"
        Stroke="{Binding Stroke}"
        StrokeThickness="{Binding StrokeThickness}"
        StrokeStartLineCap="{Binding StrokeStartLineCap}"
        StrokeEndLineCap="{Binding StrokeEndLineCap}"
        StrokeLineJoin="{Binding StrokeLineJoin}"
        StrokeMiterLimit="{Binding StrokeMiterLimit}"
        MyBackground="{Binding Background}"
        IsVertexHandle="{Binding IsVertexHandle}"
        VertexHandleFillBrush="#100f"
        Width="{Binding Width, Mode=OneWayToSource}"
        Height="{Binding Height, Mode=OneWayToSource}"
        MyOffsetLeft="{Binding X, Mode=TwoWay}"
        MyOffsetTop="{Binding Y, Mode=TwoWay}"
        >
        <!--<local:GeoLineEX.LayoutTransform>
          <RotateTransform Angle="{Binding Angle}"/>
        </local:GeoLineEX.LayoutTransform>-->
      </local:GeoLineEX>
        <!--MyRenderBounds="{Binding Bounds, Mode=OneWayToSource}"-->
                       <!--Width="{Binding Bounds.Width}"
                       Height="{Binding Bounds.Height}"-->
                       
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:EllipseData}">
    <local:CustomThumb>
      <Ellipse Width="{Binding Width}"
             Height="{Binding Height}"
             Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:GroupData}">
    <local:CustomThumb>
      <Grid d:DataContext="{d:DesignInstance Type=local:GroupData}">
        <Rectangle Stroke="Blue" StrokeThickness="1" StrokeDashArray="2,2"/>
        <ItemsControl ItemsSource="{Binding DataList}"
                      Width="{Binding Width}"
                      Height="{Binding Height}"
                      Background="Transparent"
                      ItemContainerStyle="{StaticResource CanvasItemContaier}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </local:CustomThumb>
  </DataTemplate>





  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}">
              <!--<ContentPresenter.LayoutTransform>
                <RotateTransform Angle="{Binding Angle}"/>
              </ContentPresenter.LayoutTransform>-->
            </ContentPresenter>
            <Border x:Name="SelectedBorder" Visibility="Visible"
                    BorderBrush="Orange" BorderThickness="1"
                    Margin="-10"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>







  <Style TargetType="{x:Type local:RootItemsControl}">
    <!--<Setter Property="MyData" Value="{Binding}"/>-->
    <Setter Property="ItemContainerStyle" Value="{StaticResource CanvasItemContaier}"/>
    <Setter Property="ItemsSource" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.DataList}"/>
    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.Width}"/>
    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.Height}"/>
    <!--<Setter Property="Width" Value="300"/>
    <Setter Property="Height" Value="300"/>-->

    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RootItemsControl}">
          <Grid Background="WhiteSmoke">
            <ItemsPresenter x:Name="MyPresenter"
                            Width="{Binding Width}"
                            Height="{Binding Height}"/>
            <Border BorderBrush="Orange" BorderThickness="0" Margin="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

  </Style>






  <Style TargetType="{x:Type local:FlatHandle}">
    <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyLeft, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyTop, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FlatHandle}">
          <Grid Background="{TemplateBinding MyFillBrush}">
            <Rectangle Stroke="Black" StrokeThickness="1"/>
            <Rectangle Stroke="White" StrokeThickness="1" StrokeDashArray="2,2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>




</ResourceDictionary>