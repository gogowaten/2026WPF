<Window x:Class="_20260227.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260227"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Window.Resources>
    <DataTemplate DataType="{x:Type local:RectangleData}">
      <Rectangle Width="{Binding Width}"
                 Height="{Binding Height}"
                 Fill="DodgerBlue"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:Datas}">
      <local:NodeContainer ItemsSource="{Binding Nodes}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:TextBlockData}">
      <TextBlock Text="{Binding Text}"
                 Background="Transparent"/>
    </DataTemplate>

  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <ScrollViewer>
      <local:NodeContainer ItemsSource="{Binding  RootData.Nodes}">
      </local:NodeContainer>
    </ScrollViewer>

    <StackPanel Grid.Column="1">
      <Button x:Name="Test" Content="Test" Click="Test_Click"/>
    </StackPanel>
  </Grid>
</Window>
