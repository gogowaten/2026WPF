<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:_20260227"
                    xmlns:conv="clr-namespace:_20260227.Converters">
  <conv:NegativeConverter x:Key="NegativeConverter"/>

  <DataTemplate DataType="{x:Type local:Datas}">
    <Canvas Width="{Binding Width}" 
            Height="{Binding Height}"
            Background="#55FF0000">

      <!--<Canvas.RenderTransform>
        <TranslateTransform X="{Binding ContentBounds.X, Converter={StaticResource NegativeConverter}}" 
                                Y="{Binding ContentBounds.Y, Converter={StaticResource NegativeConverter}}"/>
      </Canvas.RenderTransform>-->

      <local:NodeContainer ItemsSource="{Binding Nodes}" 
                           Width="{Binding Width}"
                           Height="{Binding Height}"/>

      <!--<TextBlock Text="{Binding Width}"/>-->
    </Canvas>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:RectangleData}">
    <Rectangle Width="{Binding Width}"
               Height="{Binding Height}"
               Fill="#550000FF"/>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:TextBlockData}">
    <TextBlock Text="{Binding Text}"
                 Background="Transparent"/>
  </DataTemplate>


</ResourceDictionary>