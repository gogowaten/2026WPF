<Application x:Class="_20260227.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_20260227"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="/Themes/NodeTemplate.xaml"/>-->
        
        <!--上記でもいいけど、下記のほうがより良い、パックURI(pack URI)形式
        これだと将来的にプロジェクト名が変わったり、クラスライブラリに切り出したときでも、
        エラーにならないでそのまま使える-->
        
        <ResourceDictionary Source="pack://application:,,,/20260227;component/Themes/NodeTemplate.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
