<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260413_04_CanvasThumbResize">




  <Style TargetType="{x:Type local:CanvasThumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CanvasThumb}">
          <Canvas x:Name="PART_Canvas"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  Background="Salmon">
            <Ellipse Width="30" Height="30" Canvas.Left="20" Canvas.Top="20" Fill="Gold"/>
            <Ellipse Width="30" Height="30" Canvas.Left="70" Canvas.Top="70" Fill="NavajoWhite"/>
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


</ResourceDictionary>
