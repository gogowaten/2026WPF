<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260403">


 
  
  
  <DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:GeoLine x:Name="GeoLine"
                   MyPoints="{Binding Points}"
                   Stroke="{Binding Stroke}"
                   StrokeThickness="{Binding StrokeThickness}"
                   Fill="{Binding Fill}"
                   StrokeEndLineCap="{Binding EndLineCap}"
                   StrokeStartLineCap="{Binding StartLineCap}"
                   StrokeLineJoin="{Binding LineJoin}"
                   StrokeMiterLimit="{Binding MiterLimit}"
                   MyIsOffset="{Binding IsOffset}"
                   />
  </DataTemplate>
  
  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{Binding}"/>
            <Border BorderBrush="Orange" BorderThickness="1"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
