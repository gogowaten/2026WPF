<Window x:Class="_20260403.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260403" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="240"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      
      <!--<local:CustomThumb x:Name="MyElement" DataContext="{Binding MyData}"/>-->
      
      <local:GeoCanvas x:Name="MyElement" DataContext="{Binding MyData}"/>
    </Canvas>
    
    <StackPanel Grid.Column="1">
      <Button Content="Change Offset" Click="Button_Click_ChangeOffset"/>
      <Button Content="Change CanDragMove" Click="Button_Click_ChangeCanDragMove"/>
      
      <Button Content="Check" Click="Button_Click_Check"/>
      <Button Content="P0 Change" Click="Button_Click"/>
      <Button Content="AddPoints" Click="Button_Click_AddPoints"/>
      <Button Content="PointsClear" Click="Button_Click_PointsClear"/>
      
      <StackPanel DataContext="{Binding MyData}">
        <TextBlock Text="{Binding IsOffset, StringFormat='IsOffset = {0}'}"/>
        <TextBlock Text="{Binding IsCanDragMove, StringFormat='IsCanDragMove = {0}'}"/>
        <TextBlock Text="{Binding StrokeThickness, StringFormat='StrokeThickness = {0:0}'}"/>
        <Slider Value="{Binding StrokeThickness}" Minimum="1" Maximum="50"/>
        <TextBlock Text="{Binding X, StringFormat='X = {0: 0.0}'}"/>
        <TextBlock Text="{Binding Width, StringFormat='Width = {0: 0.0}'}"/>
        <TextBlock Text="{Binding WidthRender, StringFormat='WidthRender = {0: 0.0}'}"/>
        <TextBlock Text="{Binding ActualSize, StringFormat='ActualSize = {0: 0.0}'}"/>
        <TextBlock Text="{Binding MyActualWidth, StringFormat='MyActualWidth = {0: 0.0}'}"/>
        <TextBlock Text="{Binding BoundsLeft, StringFormat='BoundsLeft = {0: 0.0}'}"/>
        <!--<TextBlock Text="{Binding (local:ShapeData.MyAAA), StringFormat='MyActualWidth = {0: 0.0}'}"/>-->
        
        <!--<TextBlock local:ShapeData.MyAAA="2"/>-->
      </StackPanel>
      
      <StackPanel DataContext="{Binding ElementName=MyElement, Path=MyGeoData}">
        <TextBlock Text="{Binding Points}"/>
        <TextBlock Text="{Binding IsOffset}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
