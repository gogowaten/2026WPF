<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260409">


  <Style TargetType="{x:Type local:DataThumb}">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:DataThumb}">
          <Canvas>
            <local:GeoThumb DataContext="{Binding}"/>
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  
  
  <Style TargetType="{x:Type local:GeoThumb}">
    <Setter Property="Canvas.Left" Value="{Binding InternalX}"/>
    <Setter Property="Canvas.Top" Value="{Binding InternalY}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GeoThumb}">
          <Border Background="Red"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Width="{Binding Width}"
                  Height="{Binding Height}"
                  >
            <local:GeoLine MyData="{Binding}"
                           MyPoints="{Binding MyPoints}"
                           Fill="{Binding Fill}"
                           Stroke="{Binding Stroke}"
                           StrokeThickness="{Binding StrokeThickness}"
                           StrokeEndLineCap="{Binding EndLineCap}"
                           StrokeStartLineCap="{Binding StartLineCap}"
                           StrokeLineJoin="{Binding LineJoin}"
                           StrokeMiterLimit="{Binding MiterLimit}"
                           MyIsOffset="{Binding IsOffset}"
                           MyStrokePen="{Binding StrokePen}"
                           />
            <!--<local:GeoLine Data="{Binding MyGeometry}"
                  Stroke="{Binding Stroke}"
                  StrokeThickness="{Binding StrokeThickness}"
                  
                  />-->
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
