<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260420">






  <Style TargetType="{x:Type local:GeoThumb}">
    <Setter Property="Canvas.Left" Value="{Binding InternalX}"/>
    <Setter Property="Canvas.Top" Value="{Binding InternalY}"/>
    
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GeoThumb}">
          <Border Background="MediumSlateBlue"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  >
            <local:GeoLine x:Name="PART_GeoLine"
                           MyPoints="{Binding MyPoints}"
                           Fill="{Binding Fill}"
                           Stroke="{Binding Stroke}"
                           StrokeThickness="{Binding StrokeThickness}"
                           StrokeEndLineCap="{Binding EndLineCap}"
                           StrokeStartLineCap="{Binding StartLineCap}"
                           StrokeLineJoin="{Binding LineJoin}"
                           StrokeMiterLimit="{Binding MiterLimit}"
                           MyIsOffset="{Binding IsOffset}"
                           MyStrokePen="{Binding StrokePen}"
                           MyGeometryBounds="{Binding GeometryBounds, Mode=TwoWay}"
                               />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>



