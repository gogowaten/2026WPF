<Window x:Class="_20260331.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260331" d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        mc:Ignorable="d"
        Title="MainWindow" Height="467" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="240"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <!--<local:DataThumb x:Name="MyThumb" ThumbData="{Binding MyData}"/>-->

      <!--<local:DataThumb x:Name="MyThumb" DataContext="{Binding MyData}"/>-->

      <!--<local:DataCanvas>
        <local:GeoShape x:Name="MyShape"
                        Points="50,70 250,150 50,250 50,200" Stroke="Gold" StrokeThickness="20"
                        StrokeEndLineCap="Round"
                        IsOffset="True"
                        />
      </local:DataCanvas>-->
      <!--<Grid x:Name="MyGrid" Background="DodgerBlue" Canvas.Left="20" Canvas.Top="20"
            Width="{Binding ElementName=MyShape, Path=RenderBounds.Width}"
            Height="{Binding ElementName=MyShape, Path=RenderBounds.Height}">
        <local:GeoShape x:Name="MyShape"
                        Points="50,70 250,150 50,250 50,200" Stroke="Gold" StrokeThickness="20"
                        StrokeEndLineCap="Round"
                        IsOffset="True"
                        />
      </Grid>-->
      <!--<local:CustomThumb>
        <Canvas Background="DeepSkyBlue" Width="{Binding ElementName=MyShape, Path=MyGeometryBounds.Width}"
                             Height="{Binding ElementName=MyShape, Path=MyGeometryBounds.Height}">
          <local:CustomThumb IsDragMove="True">
          </local:CustomThumb>
        </Canvas>
      </local:CustomThumb>-->
            <!--<local:GeoLine x:Name="MyShape" Canvas.Left="0" Canvas.Top="0"
                MyPoints="50,70 150,150 50,250 50,200" Stroke="Gold" StrokeThickness="20"
                StrokeEndLineCap="Round"
                MyIsOffset="True"/>-->
      
      <!--<local:GeoShape x:Name="MyShape"
                      Points="50,70 250,150 50,250 50,200 50,150 150,100 250,250" Stroke="Gold" StrokeThickness="20"
                      StrokeEndLineCap="Round"/>-->
      <local:TGeoLine x:Name="MyShape" DataContext="{Binding MyData}"/>
    </Canvas>


    <StackPanel Grid.Column="1" DataContext="{Binding MyData}">
      <TextBlock Text="{Binding Points, StringFormat='Points = {0:0}'}"/>
      <TextBlock Text="{Binding OriginBounds}"/>
      <TextBlock Text="{Binding Bounds}"/>
      <TextBlock Text="{Binding X, StringFormat='X = {0:0}'}"/>
      <TextBlock Text="{Binding Width, StringFormat='Width = {0:0}'}"/>
      <TextBlock Text="{Binding StrokeThickness, StringFormat='StrokeThickness = {0:0}'}"/>
      <Slider Value="{Binding StrokeThickness}" Minimum="1" Maximum="50"/>
      <TextBlock Text="{Binding WidthRender, StringFormat='WidthRender = {0:0}'}"/>

      <StackPanel Grid.Column="1" DataContext="{Binding ElementName=MyThumb}">
        <Button Content="ChangeOffset" Click="Button_Click_2"/>
        <TextBlock Text="{Binding ThumbData}"/>
        <Button Content="offset" Command="{Binding ChangeGeoShepeRenderOffsetCommand}"/>

        <StackPanel DataContext="{Binding ElementName=MyShape, Path=DataContext}">
          <Slider Value="{Binding StrokeThickness}" Minimum="1" Maximum="50"/>
          <TextBlock Text="{Binding IsOffset}"/>
          <TextBlock Text="{Binding Bounds, StringFormat='bounds = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding OriginBounds, StringFormat='OriginBounds = {0: 0; -0; 0}'}"/>
          <TextBlock Text="{Binding X, StringFormat='X = {0:0}'}"/>
          <TextBlock Text="{Binding Points, StringFormat='X = {0:0}'}"/>
        </StackPanel>

        <Button Content="AddPoints" Click="Button_Click"/>
        <Button Content="PointsClear" Click="Button_Click_1"/>
        <Button Content="PointChange" Click="Button_Click_PointChange"/>
        <TextBlock Text="{Binding ActualWidth, StringFormat='ShapeActualWidth = {0:0}'}"/>

      </StackPanel>
      
      <StackPanel DataContext="{Binding ElementName=MyShape}">
        <TextBlock Text="{Binding ActualWidth, StringFormat='ActualWidth = {0:0.0}'}"/>
        <TextBlock Text="{Binding MyGeometryBounds, StringFormat='MyGeometryBounds = {0: 0; -0; 0}'}"/>
        <Slider Value="{Binding StrokeThickness}" Minimum="1" Maximum="50"/>
        <Button Content="ChangeOffset" Click="Button_Click_ChangeOffset"/>
      </StackPanel>
      
    </StackPanel>
  </Grid>
</Window>