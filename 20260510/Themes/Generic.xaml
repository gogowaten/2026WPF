<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260510"  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">



  <!-- #region これは一番上に書く必要がある -->

  <Style x:Key="CanvasItemContaier">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>

  <!-- #endregion これは一番上に書く必要がある -->





  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}"/>

            <Border x:Name="SelectedBorder" Visibility="Collapsed"
                    BorderBrush="Orange" BorderThickness="1"
                    Margin="-10"
                    IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Path=IsSelected}" Value="true"/>
                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.RootData.IsVisbleSelectedBorder}" Value="true"/>
                <!--<Condition Binding="{Binding Path=MyData.RootData.IsVisbleSelectedBorder}" Value="true"/>-->
                <!--<Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:CustomThumb}, Path=MyData.RootData.IsVisbleSelectedBorder}" Value="true"/>-->
              </MultiDataTrigger.Conditions>
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--MultiDataTriggerの使い方-->
  <!--[WPF] 複数のトリガー条件を組み合わせた時に AND だけでなく OR で判断する方法 - ぐーたら書房
https://gootara.org/library/2017/01/wpfao.html-->

  




  <DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:CustomThumb>
      <!--MyData="{Binding}"-->
      <local:GeoLineEX 
        MyPoints="{Binding Points, Mode=TwoWay}"
        Stroke="{Binding Stroke}"
        StrokeThickness="{Binding StrokeThickness}"
        StrokeStartLineCap="{Binding StrokeStartLineCap}"
        StrokeEndLineCap="{Binding StrokeEndLineCap}"
        StrokeLineJoin="{Binding StrokeLineJoin}"
        StrokeMiterLimit="{Binding StrokeMiterLimit}"
        MyBackground="{Binding Background}"
        IsVertexHandle="{Binding IsVertexHandle}"
        VertexHandleFillBrush="#100f"
        Width="{Binding Width, Mode=OneWayToSource}"
        Height="{Binding Height, Mode=OneWayToSource}"
        MyOffsetLeft="{Binding X, Mode=TwoWay}"
        MyOffsetTop="{Binding Y, Mode=TwoWay}"
        MyStrokePen="{Binding StrokePen, UpdateSourceTrigger=PropertyChanged}"
        >
        <!--<local:GeoLineEX.LayoutTransform>
          <RotateTransform Angle="{Binding Angle}"/>
        </local:GeoLineEX.LayoutTransform>-->
      </local:GeoLineEX>
      <!--MyRenderBounds="{Binding Bounds, Mode=OneWayToSource}"-->
      <!--Width="{Binding Bounds.Width}"
                       Height="{Binding Bounds.Height}"-->

    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:RectangleData}">
    <local:CustomThumb>
      <Rectangle Width="{Binding Width}"
                 Height="{Binding Height}"
                 Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:EllipseData}">
    <local:CustomThumb>
      <Ellipse Width="{Binding Width}"
             Height="{Binding Height}"
             Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

