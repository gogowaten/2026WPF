  <DataTemplate DataType="{x:Type local:GroupData}">
    <DataTemplate.Resources>
      <local:MyConvBoolToVisible x:Key="isVisible"/>
      <local:MyConvGroupWakuColor x:Key="WakuColor"/>
    </DataTemplate.Resources>
    <local:CustomThumb>
      <Grid d:DataContext="{d:DesignInstance Type=local:GroupData}">
        <Rectangle x:Name="GroupWaku" StrokeThickness="1" StrokeDashArray="2,2" Margin="-2"
                   IsHitTestVisible="False"
                   Visibility="{Binding Converter={StaticResource isVisible},
                        RelativeSource={RelativeSource AncestorType=local:CustomThumb},
                        Path=MyData.RootData.IsVisbleGroupBorder}"
                   >
          <!--枠の色、編集モードと通常時-->
          <Rectangle.Stroke>
            <MultiBinding Converter="{StaticResource WakuColor}">
              <MultiBinding.Bindings>
                <Binding Path="IsEditing"/>
                <Binding RelativeSource="{RelativeSource AncestorType=local:CustomThumb}"
                         Path="MyData.RootData.GroupBorderNormalColor"/>
                <Binding RelativeSource="{RelativeSource AncestorType=local:CustomThumb}"
                         Path="MyData.RootData.GroupBorderEditingColor"/>
              </MultiBinding.Bindings>
            </MultiBinding>
          </Rectangle.Stroke>
        </Rectangle>
        
        <ItemsControl ItemsSource="{Binding DataList}"
                      Width="{Binding Width}"
                      Height="{Binding Height}"
                      ItemContainerStyle="{StaticResource CanvasItemContaier}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </local:CustomThumb>
  </DataTemplate>




