<Window x:Class="_20260327.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20260327"
        mc:Ignorable="d"
     Title="MainWindow" Height="367" Width="654">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="240"/>
    </Grid.ColumnDefinitions>

    <Canvas x:Name="MyCanvas">
      <Grid x:Name="MyGrid" Background="Silver" Canvas.Left="20" Canvas.Top="20"
            Width="{Binding ElementName=MyShape, Path=RenderBounds.Width}"
            Height="{Binding ElementName=MyShape, Path=RenderBounds.Height}">
        <local:GeoShape x:Name="MyShape"
                        Points="50,70 250,150 50,250 50,200" Stroke="Gold" StrokeThickness="20"
                        StrokeEndLineCap="Round"
                        IsOffset="True"
                        PreviewMouseDown="MyShape_PreviewMouseDown"/>
      </Grid>

      <!--<local:GeoShape x:Name="MyShape"
                      Points="50,70 250,150 50,250 50,200 50,150 150,100 250,250" Stroke="Gold" StrokeThickness="20"
                      StrokeEndLineCap="Round"/>-->

    </Canvas>

    <StackPanel Grid.Column="1" DataContext="{Binding ElementName=MyShape}">
      <Button Content="AddPoints" Click="Button_Click"/>
      <TextBlock Text="{Binding ActualWidth, StringFormat='ActualWidth = {0:0}'}"/>
      <TextBlock Text="{Binding IsFocused, StringFormat='IsOffset = {0:0}'}"/>
      <TextBlock Text="{Binding RenderBounds, StringFormat='RenderBounds = {0: 0}'}"/>
      <TextBlock Text="{Binding OriginRenderBounds, StringFormat='OriginRenderBounds = {0: 0; -0; 0}'}"/>
      <TextBlock Text="{Binding ElementName=MyGrid, Path=ActualWidth, StringFormat='GridActualWidth = {0: 0}'}"/>
      <TextBlock Text="{Binding ElementName=MyGrid, Path=ActualWidth, StringFormat='{}{0:F0}'}"/>
    </StackPanel>
  </Grid>
</Window>