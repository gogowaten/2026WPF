<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260428"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">



  <!-- #region これは一番上に書く必要がある -->

  <Style x:Key="CanvasItemContaier">
    <Setter Property="Canvas.Left" Value="{Binding X}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
    <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
  </Style>

  <!-- #endregion これは一番上に書く必要がある -->


  <DataTemplate DataType="{x:Type local:GeoLineData}">
    <local:CustomThumb>
      <local:GeoLineEX MyPoints="{Binding Points}"
                       Stroke="{Binding Stroke}"
                       StrokeThickness="{Binding StrokeThickness}"
                       Background="{Binding Background}"
                       IsVertexHandle="{Binding IsVertexHandle}"
                       VertexHandleFillBrush="#100f"
                       VertexHandleSize="50"
                       MySurfaceWidth="{Binding Width, Mode=OneWayToSource}"
                       MySurfaceHeight="{Binding Height, Mode=OneWayToSource}"
                       MyOffsetLeft="{Binding OffsetX}"
                       MyOffsetTop="{Binding OffsetY}"
                     />
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:EllipseData}">
    <local:CustomThumb>
      <Ellipse Width="{Binding Width}"
             Height="{Binding Height}"
             Fill="{Binding Fill}"/>
    </local:CustomThumb>
  </DataTemplate>

  <DataTemplate DataType="{x:Type local:GroupData}">
    <local:CustomThumb>
      <Grid d:DataContext="{d:DesignInstance Type=local:GroupData}">
        <Rectangle Stroke="Blue" StrokeThickness="1" StrokeDashArray="2,2"/>
        <ItemsControl ItemsSource="{Binding DataList}"
                      Width="{Binding Width}"
                      Height="{Binding Height}"
                      Background="Transparent"
                      ItemContainerStyle="{StaticResource CanvasItemContaier}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </local:CustomThumb>
  </DataTemplate>





  <Style TargetType="{x:Type local:CustomThumb}">
    <Setter Property="MyData" Value="{Binding}"/>
    <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CustomThumb}">
          <Grid>
            <ContentPresenter Content="{TemplateBinding MyContent}"/>
            <Border x:Name="SelectedBorder" Visibility="Collapsed"
                    BorderBrush="Orange" BorderThickness="1"
                    Margin="-10"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="SelectedBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>







  <Style TargetType="{x:Type local:RootItemsControl}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource CanvasItemContaier}"/>
    <Setter Property="ItemsSource" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyData.DataList}"/>

    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Canvas IsItemsHost="True"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:RootItemsControl}">
          <Grid Background="WhiteSmoke">
            <ItemsPresenter x:Name="MyPresenter"
                            Width="{Binding Width}"
                            Height="{Binding Height}"/>
            <Border BorderBrush="Orange" BorderThickness="0" Margin="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

  </Style>




  
  
  <Style TargetType="{x:Type local:FlatHandle}">
    <Setter Property="Canvas.Left" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyLeft, Mode=TwoWay}"/>
    <Setter Property="Canvas.Top" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=MyTop, Mode=TwoWay}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:FlatHandle}">
          <Grid Background="{TemplateBinding MyFillBrush}">
            <Rectangle Stroke="Black" StrokeThickness="1"/>
            <Rectangle Stroke="White" StrokeThickness="1" StrokeDashArray="2,2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>




</ResourceDictionary>
