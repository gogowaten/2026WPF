<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:_20260324">



  <Style TargetType="{x:Type local:GeoLineThumb}">
    <Style.Resources>
      <!--<DataTemplate DataType="local:GeoLineData">
        <local:GeoLine Points="{Binding Points}"
                       Stroke="{Binding Brush}"
                       StrokeThickness="{Binding StrokeThickness}"
                       Canvas.Left="{Binding XP}"
                       Canvas.Top="{Binding YP}"/>
      </DataTemplate>-->
    </Style.Resources>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GeoLineThumb}">
          <Border Background="{Binding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Canvas>
              <local:GeoLine Points="{Binding Points}"
                           Stroke="{Binding Brush}"
                          StrokeThickness="{Binding StrokeThickness}"
                          Canvas.Left="{Binding XP}"
                          Canvas.Top="{Binding YP}"
                           />
            </Canvas>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>



  <!--<Style TargetType="{x:Type local:CustomControl1}">
